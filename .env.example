# ============================================================================
# MEDICINA 2029 — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# TAREFA F1.06: SEGURANÇA DE VARIÁVEIS, SEGREGAÇÃO DE IA E CONEXÕES SEGREGADAS
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local em ambiente de desenvolvimento local.
# 2. NUNCA comite credenciais, segredos ou chaves reais no repositório Git.
# 3. Em produção, configure os segredos diretamente no painel do provedor de hospedagem (Vercel, Cloud Run, etc.).
# ============================================================================

# ----------------------------------------------------------------------------
# 1. AMBIENTE E RUNTIME
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ----------------------------------------------------------------------------
# 2. AUTENTICAÇÃO (NextAuth)
# ----------------------------------------------------------------------------
# URL canônica da aplicação (ex: https://medicina.seudominio.com.br em produção)
NEXTAUTH_URL=http://localhost:3000

# Chave secreta de assinatura de tokens de sessão (JWT)
# OBRIGATÓRIO: mínimo de 32 caracteres de alta entropia em produção.
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=sua_chave_secreta_aqui_com_minimo_32_caracteres_aleatorios_12345

# ----------------------------------------------------------------------------
# 3. CONEXÕES POSTGRESQL (ARQUITETURA DE SEGREGAÇÃO F1.04-C / F1.06)
# ----------------------------------------------------------------------------
# URL Geral de Conexão (Utilizada em desenvolvimento ou como fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicina_dev

# URL de Conexão da Aplicação (Papel medicina_app: sem acesso a password_hash, sem execute em auth)
# Recomendado para produção nas Server Actions cotidianas:
# DATABASE_APP_URL=postgresql://medicina_app:senha_forte_app@seu-db-cluster:5432/medicina_prod

# URL de Conexão de Autenticação (Papel medicina_auth: exclusivo do NextAuth para checar credenciais)
# Recomendado para produção na rota /api/auth:
# DATABASE_AUTH_URL=postgresql://medicina_auth:senha_forte_auth@seu-db-cluster:5432/medicina_prod

# Flag defensiva (se true, permite localhost em NODE_ENV=production para ensaios locais controlados)
ALLOW_LOCALHOST_IN_PRODUCTION=false

# ----------------------------------------------------------------------------
# 4. PROVEDORES DE INTELIGÊNCIA ARTIFICIAL (Google Gemini)
# ----------------------------------------------------------------------------
# Chave da API Google AI Studio / Gemini 2.5 Flash
# ATENÇÃO (F1.06): O sistema rejeita estritamente chaves de outros provedores (ex: ANTHROPIC_API_KEY).
# A chave é transmitida com segurança via cabeçalho HTTP x-goog-api-key, nunca na query string.
GEMINI_API_KEY=sua_chave_da_api_google_gemini_aqui

# ----------------------------------------------------------------------------
# 5. ARMAZENAMENTO DE ARQUIVOS (Supabase Storage)
# ----------------------------------------------------------------------------
# URL e chave anônima do Supabase Storage para o bucket 'acervo'
# Fallbacks hardcoded com projetos reais foram eliminados em F1.06.
SUPABASE_URL=https://seu-projeto-id.supabase.co
SUPABASE_ANON_KEY=sua_supabase_anon_public_key_aqui
